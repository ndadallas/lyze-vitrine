# Base Postgres (Vercel > Storage > Neon la remplit toute seule en production).
# En local : une base Postgres de dev, par ex. une branche Neon séparée.
DATABASE_URL="postgresql://user:password@host:5432/lyze?sslmode=require"

# Formulaire de contact (vitrine) : clé API Resend (resend.com). Sans clé, le site ouvre la messagerie du visiteur.
RESEND_API_KEY=""
# Destinataire des messages et expéditeur (domaine vérifié chez Resend)
CONTACT_TO="contact@lyze.ma"
CONTACT_FROM="Site Lyze <site@lyze.ma>"
